# Local development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) - used with prisma/schema.postgres.prisma
# DATABASE_URL="postgresql://opusclip:opusclip_password@localhost:5432/opusclip?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-32-byte-base64-secret-in-production"

# Account admission mode: "invitation-only" (default, fail-closed) or "open"
ACCOUNT_ADMISSION_MODE="invitation-only"

# CLI-only bootstrap admin credentials (used by `npm run bootstrap:admin`)
BOOTSTRAP_ADMIN_EMAIL="admin@opusclip.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMeImmediately123!"
BOOTSTRAP_ADMIN_NAME="Workspace Admin"
